{
  "name": "aether-anime",
  "version": "1.0.0",
  "description": "Aether Anime — Modern Cyberpunk Anime Platform recreating Otakulogia with Synthwave aesthetic",
  "main": "server.js",
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"magenta,cyan\" \"node server.js\" \"vite\"",
    "start": "concurrently -n \"SERVER,CLIENT\" -c \"magenta,cyan\" \"node server.js\" \"vite\"",
    "server": "node server.js",
    "client": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy:netlify": "netlify deploy --prod --dir=dist",
    "deploy:vercel": "vercel --prod",
    "deploy:cloudflare": "wrangler pages deploy dist --project-name=aether-anime"
  },
  "keywords": [
    "anime",
    "otakulogia",
    "streaming",
    "synthwave",
    "cyberpunk"
  ],
  "type": "commonjs",
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "concurrently": "^10.0.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-react": "^6.2.1",
    "tailwindcss": "^4.0.0",
    "vite": "^8.3.6",
    "wrangler": "^4.158.0"
  }
}
